<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- CA1848/CA1873: LoggerMessage source generators are not required for this codebase size.
         CA2007: ConfigureAwait is irrelevant in ASP.NET Core.
         CA1062: nullable reference types cover argument null checks.
         CA1031: background jobs intentionally catch all exceptions to record failures.
         CA1515: public types are required for WebApplicationFactory and EF tooling. -->
    <NoWarn>$(NoWarn);CA1848;CA1873;CA2007;CA1062;CA1031;CA1515;CA1711;CA1716;CA1720;CA1724;CA1305;CA1307;CA1309;CA1310;CA1304;CA1311;CA1308;CA1819;CA1002;CA2227;CA1056;CA1054;CA1055;CA1034;CA1052;CA1812;CA5394;CA1805;CA1822;CA1861;CA1869</NoWarn>
    <Authors>Medin Turkes</Authors>
    <Product>AngebotPilot</Product>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
</Project>
