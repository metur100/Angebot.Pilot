{
  "ConnectionStrings": {
    "Default": "Server=(localdb)\\MSSQLLocalDB;Database=AngebotPilot_Dev;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "App": {
    "WebBaseUrl": "http://localhost:5173/#",
    "ApiBaseUrl": "http://localhost:5080"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:4173", "http://localhost:8081" ]
  },
  "Email": {
    "Provider": "Capture",
    "CaptureDirectory": "App_Data/emails"
  },
  "Billing": {
    "MockAllowsSelfService": true
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "RateLimits": {
    "Scale": 20
  }
}
