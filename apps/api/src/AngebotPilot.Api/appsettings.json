{
  "ConnectionStrings": {
    "Default": ""
  },
  "App": {
    "WebBaseUrl": "https://metur100.github.io/Angebot.Pilot.App/#",
    "ApiBaseUrl": "https://angebotpilot.runasp.net",
    "LandingUrl": "https://metur100.github.io/Angebot.Pilot.Landing/",
    "PublicLinkGraceDays": 60
  },
  "Jwt": {
    "Issuer": "angebotpilot-api",
    "Audience": "angebotpilot-clients",
    "SigningKey": ""
  },
  "Auth": {
    "AccessTokenLifetime": "00:15:00",
    "RefreshTokenLifetime": "30.00:00:00",
    "WebRefreshTransport": "Body"
  },
  "Cors": {
    "AllowedOrigins": [ "https://metur100.github.io" ]
  },
  "Storage": {
    "Provider": "Local",
    "LocalRoot": "App_Data/storage"
  },
  "Email": {
    "Provider": "Capture",
    "FromAddress": "no-reply@example.invalid",
    "FromName": "AngebotPilot",
    "SmtpPort": 587,
    "SmtpSecurity": "StartTls"
  },
  "Billing": {
    "Provider": "mock",
    "MockAllowsSelfService": false,
    "WebhookSecret": ""
  },
  "Jobs": {
    "EnableHostedScheduler": true,
    "Interval": "00:01:00",
    "TriggerSecret": ""
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Network": {
    "TrustForwardedHeaders": false
  },
  "Serilog": {
    "MinimumLevel": { "Default": "Information" }
  },
  "AllowedHosts": "*"
}
