# Copy to .env.local and adjust. Never commit real secrets – the web app only needs public URLs.

# Origin of the AngebotPilot API (without /api/v1).
# Local development: http://localhost:5080 · Production: https://angebotpilot.runasp.net
VITE_API_BASE_URL=http://localhost:5080

# Public marketing/legal site (Impressum, Datenschutz, AGB). Must end with a slash.
VITE_LANDING_URL=https://metur100.github.io/Angebot.Pilot.Landing/

# Base path of the built app. GitHub Pages: /Angebot.Pilot.App/ · local preview: /
VITE_BASE_PATH=/Angebot.Pilot.App/

# Dev only: serve the API from in-browser MSW mocks (ignored in production builds).
# Alternatively run `npm run dev:mock`.
VITE_USE_MOCKS=false
