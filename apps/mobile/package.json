{
  "name": "angebotpilot-mobile",
  "version": "1.0.0",
  "description": "AngebotPilot – native Android & iOS app (Expo / React Native).",
  "author": "Medin Turkes",
  "license": "UNLICENSED",
  "private": true,
  "main": "expo-router/entry",
  "dependencies": {
    "@angebotpilot/api-contracts": "file:../../packages/api-contracts",
    "@angebotpilot/brand": "file:../../packages/brand",
    "@expo/vector-icons": "^15.1.1",
    "@hookform/resolvers": "^5.9.1",
    "@react-native-community/datetimepicker": "^9.1.0",
    "@tanstack/react-query": "^5.104.2",
    "big.js": "^7.0.1",
    "expo": "~57.0.28",
    "expo-asset": "~57.0.19",
    "expo-build-properties": "~57.0.22",
    "expo-camera": "~57.0.6",
    "expo-constants": "~57.0.21",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.12",
    "expo-network": "~57.0.2",
    "expo-router": "~57.0.26",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.23",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "^19.2.3",
    "react-hook-form": "^7.90.0",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "^1.21.9",
    "react-native-reanimated": "^4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "^0.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.86.3",
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/react-native": "^13.3.3",
    "@types/big.js": "^6.2.2",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.6",
    "react-test-renderer": "^19.2.3",
    "sharp": "^0.35.5",
    "typescript": "~5.9.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "jest",
    "verify": "npm run typecheck && npm run lint && npm test",
    "assets": "node scripts/render-assets.mjs",
    "bundle:check": "expo export --platform android --output-dir dist-check",
    "prebuild:android": "expo prebuild --platform android --clean"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "./jest.setup.ts"
    ],
    "testMatch": [
      "<rootDir>/__tests__/**/*.test.ts?(x)"
    ],
    "roots": [
      "<rootDir>"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|react-navigation|@react-navigation/.*|react-native-svg|@angebotpilot/.*|react-native-keyboard-controller|standard-navigation))"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^big.js$": "<rootDir>/node_modules/big.js",
      "^zod$": "<rootDir>/node_modules/zod"
    },
    "setupFilesAfterEnv": [
      "./jest.setup-after-env.ts"
    ]
  }
}
